@page
@model GameLibrary.Web.Pages.Games.EditModel

@{
    ViewData["Title"] = "Edit Game";
}

<h1>Edit Game</h1>

<form method="post">
    <input type="hidden" asp-for="Game.GameId" />

    <p>
        <label asp-for="Game.GameTitle">Title:</label>
        <input asp-for="Game.GameTitle" required />
    </p>

    <p>
        <label asp-for="Game.ReleaseYear">Release Year:</label>
        <input asp-for="Game.ReleaseYear" type="number" min="1970" max="2100" required />
    </p>

    <p>
        <label asp-for="Game.FranchiseId">Franchise:</label>
        <select asp-for="Game.FranchiseId" asp-items="Model.Franchises"></select>
    </p>

    <p>
        <label asp-for="Game.PlatformId">Platform:</label>
        <select asp-for="Game.PlatformId" asp-items="Model.Platforms"></select>
    </p>

    <button type="submit">Save Changes</button>
    <a asp-page="./Index">Cancel</a>
</form>